{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signaturmonster",
  "version": "0.1.0",
  "identifier": "de.monstersuite.signaturmonster.viewer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Christof Holdermann",
    "homepage": "https://signaturmonster.monstersuite.de",
    "category": "Productivity",
