# ─── Sicherheit ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── Lizenz ───────────────────────────────────────────────────────────────────
# URL des Lizenzservers (Produktion: https://monstersuite.de)
LICENSE_SERVER_URL=https://monstersuite.de

# Grace Period bei Serverausfall (Tage, Standard: 14)
LICENSE_GRACE_DAYS=14

# Nur für Entwicklung/Demo: ermöglicht offline signierte HMAC-Keys
# In Produktion NICHT setzen — Lizenzprüfung läuft ausschließlich über monstersuite.de
# LICENSE_SECRET=

# ─── SMTP-Proxy Auth & TLS ────────────────────────────────────────────────────
# Maximale Mails pro Minute pro Client-IP (Standard: 30)
RATE_LIMIT_PER_MINUTE=30

# TLS-Zertifikat für STARTTLS (leer = selbstsigniertes Zertifikat wird auto-generiert)
# TLS_CERT_FILE=/data/tls/smtp.crt
# TLS_KEY_FILE=/data/tls/smtp.key

# ─── Datenquellen ─────────────────────────────────────────────────────────────
LEXWARE_API_TOKEN=your-lexware-token-here
